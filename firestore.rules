rules_version = '2';

// APA Captain data model: every captain's data lives under captains/{uid}/**
// (players, matches, archives, schedule, settings/season, settings/apa).
// Each signed-in user may read and write ONLY their own subtree — nobody can
// read or write another captain's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /captains/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
